#!/system/bin/sh
# ============================================
# 闪讯(Netkeeper) 定时自动重启 + 自动登录 + 掉线守护
# Magisk 模块版
# ============================================

# ========== 配置区 ==========
PACKAGE="com.xinli.netkeeper"
# ===========================

LOG_FILE="/data/local/tmp/shanxun_restart.log"
MAX_LOG_LINES=200
WAIT_AFTER_KILL=3
WAIT_UI_READY=5
MAX_RETRY=3
CHECK_INTERVAL=30                     # 守护检查间隔（秒），30秒
RESTART_HOUR=4                        # 每日定时重启小时
RESTART_MINUTE=0                      # 每日定时重启分钟
ENABLE_SCHEDULED=true                 # 启用定时重启
ENABLE_WATCHDOG=true                  # 启用掉线检测

log() {
    local msg="[$(date '+%Y-%m-%d %H:%M:%S')] $1"
    echo "$msg"
    echo "$msg" >> "$LOG_FILE"
    if [ -f "$LOG_FILE" ]; then
        local lines=$(wc -l < "$LOG_FILE")
        if [ "$lines" -gt "$MAX_LOG_LINES" ]; then
            local tmp=$(mktemp)
            tail -n $((MAX_LOG_LINES / 2)) "$LOG_FILE" > "$tmp"
            mv "$tmp" "$LOG_FILE"
        fi
    fi
}

is_running() { [ -n "$(pidof "$PACKAGE" 2>/dev/null)" ]; }

force_stop() {
    log "停止闪讯..."
    am force-stop "$PACKAGE" 2>/dev/null
    local pids=$(pidof "$PACKAGE" 2>/dev/null)
    [ -n "$pids" ] && kill -9 $pids 2>/dev/null
    sleep "$WAIT_AFTER_KILL"
}

launch_app() {
    input keyevent KEYCODE_WAKEUP
    sleep 0.5
    input swipe 540 2000 540 800
    sleep 1
    input keyevent KEYCODE_HOME
    sleep 1
    am start -n "${PACKAGE}/com.xinli.wenet.activitys.WelcomeActivity" >/dev/null 2>&1
}

check_network() {
    ping -c 1 -W 3 www.baidu.com >/dev/null 2>&1
}

# ============================================
# UI 自动化
# ============================================
dump_ui() {
    local f="/data/local/tmp/shanxun_ui.xml"
    local n=0
    while [ "$n" -lt 3 ]; do
        rm -f "$f"
        input keyevent KEYCODE_WAKEUP 2>/dev/null
        sleep 0.5
        uiautomator dump "$f" >/dev/null 2>&1
        if [ -f "$f" ] && [ -s "$f" ]; then
            cat "$f" 2>/dev/null
            return 0
        fi
        n=$((n+1)); sleep 2
    done
    echo ""
    return 1
}

find_center() {
    local attr="$1" val="$2" xml="$3"
    local bounds=$(echo "$xml" | tr '>' '\n' | grep "${attr}=\"[^\"]*${val}[^\"]*\"" \
        | grep -o 'bounds="\[[0-9]*,[0-9]*\]\[[0-9]*,[0-9]*\]"' | head -1 | sed 's/bounds="//;s/"//')
    [ -z "$bounds" ] && return 1
    local l=$(echo "$bounds" | sed 's/\[//g;s/\]/ /g' | awk '{print $1}' | cut -d, -f1)
    local t=$(echo "$bounds" | sed 's/\[//g;s/\]/ /g' | awk '{print $1}' | cut -d, -f2)
    local r=$(echo "$bounds" | sed 's/\[//g;s/\]/ /g' | awk '{print $2}' | cut -d, -f1)
    local b=$(echo "$bounds" | sed 's/\[//g;s/\]/ /g' | awk '{print $2}' | cut -d, -f2)
    echo "$(( (l+r)/2 )) $(( (t+b)/2 ))"
}

tap_at() {
    [ -n "$1" ] && input tap $(echo "$1" | awk '{print $1}') $(echo "$1" | awk '{print $2}')
}

try_tap_text() {
    local xml="$1" text="$2"
    local c=$(find_center "text" "$text" "$xml")
    if [ -n "$c" ]; then
        log "点击: \"$text\""
        tap_at "$c"
        return 0
    fi
    return 1
}

try_tap_id() {
    local xml="$1" id="$2"
    local c=$(find_center "resource-id" "$id" "$xml")
    if [ -n "$c" ]; then
        log "点击: $id"
        tap_at "$c"
        return 0
    fi
    return 1
}

fill_field() {
    local xml="$1" attr="$2" val="$3" text="$4"
    local c=$(find_center "$attr" "$val" "$xml")
    [ -z "$c" ] && return 1
    tap_at "$c"
    sleep 0.5
    input keyevent KEYCODE_CTRL_A
    sleep 0.2
    input keyevent KEYCODE_DEL
    sleep 0.2
    input text "$text"
    return 0
}

auto_login() {
    log "===== 点击连接 ====="
    sleep "$WAIT_UI_READY"
    local xml=$(dump_ui)
    [ -z "$xml" ] && { log "无法获取UI"; return 1; }

    # 已连接就不点了，但验一下网络
    if echo "$xml" | grep -q 'resource-id="com.xinli.netkeeper:id/aw"'; then
        log "已有断开按钮，跳过点击"
        if check_network; then
            log "✓ 网络已通"
            return 0
        else
            log "✗ 有断开按钮但网络不通"
            return 1
        fi
    fi

    # 点「连 接」按钮: id/b1
    local c=$(find_center "resource-id" "com.xinli.netkeeper:id/b1" "$xml")
    [ -z "$c" ] && c=$(find_center "text" "连 接" "$xml")
    if [ -n "$c" ]; then
        tap_at "$c"
        log "✓ 已点击连接"
    else
        log "找不到连接按钮"
        return 1
    fi

    sleep 8
    if check_network; then
        log "✓ 网络已通"
        return 0
    else
        log "✗ 网络不通"
        return 1
    fi
}

# ============================================
# 重启 + 登录
# ============================================
restart() {
    log "========== 重启闪讯 =========="
    force_stop
    sleep 2
    launch_app
    sleep "$WAIT_UI_READY"

    if ! is_running; then
        log "启动失败，重试..."
        launch_app
        sleep "$WAIT_UI_READY"
    fi
    is_running || { log "✗ 闪讯无法启动"; return 1; }

    local n=0
    while [ "$n" -lt "$MAX_RETRY" ]; do
        n=$((n+1))
        log "登录尝试 $n/$MAX_RETRY"
        auto_login && return 0
        input keyevent KEYCODE_BACK; sleep 2
    done
    log "========== 登录失败 =========="
    return 1
}

# ============================================
# 守护模式
# ============================================
daemon() {
    log "===== 守护启动 ====="
    log "检查间隔:${CHECK_INTERVAL}s 定时:${RESTART_HOUR}:${RESTART_MINUTE} 掉线检测:${ENABLE_WATCHDOG}"
    local last_day=-1
    while true; do
        local h=$(date '+%H' | sed 's/^0//')
        local m=$(date '+%M' | sed 's/^0//')
        local d=$(date '+%j')

        # 定时重启
        if $ENABLE_SCHEDULED && [ "$h" -eq "$RESTART_HOUR" ] && [ "$m" -eq "$RESTART_MINUTE" ] && [ "$d" != "$last_day" ]; then
            log "定时重启触发"
            restart; last_day="$d"
        fi

        # 掉线检测：断网就直接 kill → 重启 → 登录
        if $ENABLE_WATCHDOG; then
            if ! is_running; then
                log "闪讯进程不在了，直接重启+登录"
                restart
            elif ! check_network; then
                log "断网！等3s二次确认..."
                sleep 3
                if ! check_network; then
                    log "确认断网，kill → 重启 → 重新登录"
                    restart
                else
                    log "网络恢复，虚惊一场"
                fi
            fi
        fi
        sleep "$CHECK_INTERVAL"
    done
}

status() {
    echo "=== 闪讯守护状态 ==="
    is_running && echo "闪讯: 运行中 ✓ (PID: $(pidof "$PACKAGE"))" || echo "闪讯: 未运行 ✗"
    check_network && echo "网络: 已通 ✓" || echo "网络: 不通 ✗"
    local dp=$(ps -ef 2>/dev/null | grep "shanxun-restart daemon" | grep -v grep | awk '{print $2}')
    [ -n "$dp" ] && echo "守护: 运行中 (PID:$dp)" || echo "守护: 未运行"
    echo ""; echo "=== 日志 ==="
    [ -f "$LOG_FILE" ] && tail -15 "$LOG_FILE" || echo "(无)"
}

case "$1" in
    restart) restart ;;
    stop)    force_stop ;;
    start)   launch_app ;;
    daemon)  daemon ;;
    status)  status ;;
    *)       echo "用法: shanxun-restart {restart|stop|start|daemon|status}" ;;
esac
